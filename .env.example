# ========================================================
# ParcelFlow Environment Configuration
# ========================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret for Signing Authentication Tokens (HS256)
JWT_SECRET=replace_with_secure_secret

# Hardware Device Token for ESP32 Controllers
DEVICE_TOKEN=replace_with_secure_device_token

# SQLite Database Storage
DATABASE_PATH=parcelflow.sqlite

# Firebase Client Configuration for Google Sign-In
# (Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
