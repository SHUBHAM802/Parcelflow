# ========================================================
# ParcelFlow Environment Configuration
# ========================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ── Auth (REQUIRED) ──────────────────────────────────────
# JWT Secret for signing authentication tokens (HS256)
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_secure_jwt_secret_at_least_32_chars

# Label HMAC secret for QR code payload integrity
# Must be at least 32 characters.
LABEL_SECRET=replace_with_secure_label_secret_at_least_32_chars

# ── Hardware (REQUIRED for hardware API) ─────────────────
# Device token for ESP32 controllers. Min 32 characters.
DEVICE_TOKEN=replace_with_secure_device_token_at_least_32_chars

# Rotation slot: set DEVICE_TOKEN_NEXT to rotate without downtime
# DEVICE_TOKEN_NEXT=

# ── Database ─────────────────────────────────────────────
DATABASE_PATH=parcelflow.sqlite

# ── Hardware Configuration ───────────────────────────────
# Mode: 'simulator' (in-process simulation) | 'real' (physical ESP32)
HARDWARE_MODE=simulator

# Scan mode: 'stop_and_scan' (belt stops at IR1) | 'on_the_fly' (continuous)
SCAN_MODE=stop_and_scan

# Timeouts (milliseconds)
SCAN_TIMEOUT_MS=6000
ARM_ACK_TIMEOUT_MS=5000
ARM_COMPLETE_TIMEOUT_MS=20000
HEARTBEAT_TIMEOUT_MS=6000
IR_DEBOUNCE_MS=250
IR2_MATCH_WINDOW_MS=30000

# Reject policy: 'stop' (halt belt) | 'continue' (let pass)
SCAN_REJECT_POLICY=stop

# Single parcel mode: 'true' (one parcel in flight) | 'false'
SINGLE_PARCEL_MODE=true

# ── Firebase (Optional — Google Sign-In) ─────────────────
# Server-side project ID for token verification
FIREBASE_PROJECT_ID=

# Client-side Firebase config (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── UI Feature Flags ─────────────────────────────────────
# Show seed/demo account credentials on login page
VITE_SHOW_DEMO_ACCOUNTS=false

# Show demo helper controls (create demo orders, etc.)
VITE_ENABLE_DEMO_HELPERS=false

# ── CORS ─────────────────────────────────────────────────
# Allowed origin for CORS (defaults to same-origin if empty)
ALLOWED_ORIGIN=
